        "jsCode": "const item = $input.first().json || {};\nconst headers = item.headers || {};\nconst got = String(headers['x-internal-secret'] || headers['X-Internal-Secret'] || '').trim();\nconst expected = String($env.INTERNAL_WEBHOOK_SECRET || '').trim();\nif (!expected || got !== expected) {\n  throw new Error('Unauthorized');\n}\nconst body = item.body && typeof item.body === 'object' ? item.body : item;\nconst system = String(body.system || '').trim();\nconst messages = Array.isArray(body.messages) ? body.messages : [];\nif (!system && !messages.length) {\n  throw new Error('system or messages is required');\n}\nconst openrouterMessages = [];\nif (system) openrouterMessages.push({ role: 'system', content: system });\nfor (const message of messages) {\n  if (!message || (message.role !== 'user' && message.role !== 'assistant' && message.role !== 'system')) continue;\n  const content = String(message.content || '').trim();\n  if (!content) continue;\n  openrouterMessages.push({ role: message.role, content });\n}\nif (!openrouterMessages.length) {\n  throw new Error('No valid messages');\n}\nreturn [{ json: { openrouterMessages } }];"

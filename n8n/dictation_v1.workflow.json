        "jsCode": "const item = $input.first().json || {};\nif (item.error) {\n  const message = item.error.message || item.error.description || 'Gemini 3.5 Transcribe request failed';\n  return [{ json: { ok: false, statusCode: 502, error: String(message) } }];\n}\nconst candidate = item.candidates && item.candidates[0];\nif (!candidate) {\n  return [{ json: { ok: false, statusCode: 502, error: 'Gemini 3.5 Transcribe returned no result' } }];\n}\nconst parts = (candidate.content && candidate.content.parts) || [];\nconst text = parts\n  .map((p) => (p && p.audioTranscription && p.audioTranscription.text) || (p && p.text) || '')\n  .filter(Boolean)\n  .join(' ')\n  .trim();\nreturn [{ json: { ok: true, text, model: item.modelVersion || 'gemini-3.5-transcribe' } }];"

        "jsCode": "const item = $input.first().json || {};\nconst headers = item.headers || {};\nconst got = String(headers['x-internal-secret'] || '').trim();\nconst expected = String($env.INTERNAL_WEBHOOK_SECRET || '').trim();\nif (!expected || got !== expected) {\n  return [{ json: { valid: false, statusCode: 401, error: 'Unauthorized' } }];\n}\nconst body = item.body && typeof item.body === 'object' ? item.body : {};\nconst audio = String(body.audio || '');\nconst mimeType = String(body.mimeType || '').trim();\nif (!audio || !mimeType) {\n  return [{ json: { valid: false, statusCode: 400, error: 'audio and mimeType are required' } }];\n}\nreturn [{ json: { valid: true, audio, mimeType } }];"

    {
      "parameters": {
        "jsCode": "const labels = [\n  \"فایل صوتی اول:\",\n  \"فایل صوتی دوم:\",\n  \"فایل صوتی سوم:\",\n  \"فایل صوتی چهارم:\",\n  \"فایل صوتی پنجم:\"\n];\n\nlet output = \"\";\n\nitems.forEach((item, index) => {\n  const file = item.json.file;\n  const label = labels[index] || `فایل صوتی شماره ${index + 1}:`;\n\n  output += `{ \"text\": \"${label}\" },\\n`;\n  output += `{ \"fileData\": { \"mimeType\": \"${file.mimeType}\", \"fileUri\": \"${file.uri}\" } },\\n`;\n});\n\nreturn [\n  {\n    json: {\n      result: output.trim().replace(/,$/, \"\")\n    }\n  }\n];\n"
      },

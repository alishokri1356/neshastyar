# Backend Environment Variables
# Copy this file to .env and update the values

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=modiryar
DB_USER=modiryar_app
DB_PASSWORD=MY-PASSWORD
# Optional: use MySQL socket instead of TCP (helpful when localhost works but 127.0.0.1 fails)
# DB_SOCKET_PATH=/var/run/mysqld/mysqld.sock

# Server Configuration
PORT=3001
NODE_ENV=development

# JWT Configuration
JWT_SECRET=c64a5332ca658dc88cf932209d6febcb6063b238dd64dcbbfe3e4ffcd33aed74a29b2b836df00d133c464b9371cf348e570b571373a916c56d435ba24f08ea5d
JWT_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Internal webhook secret for n8n sync endpoint
INTERNAL_WEBHOOK_SECRET=your-long-random-secret-here

# n8n analyze webhook (meetingId sent in X-Meeting-Id header)
ANALYZE_WEBHOOK_URL=https://n8nnew.teraxr.com/webhook/add5d58a-54b1-4459-96f2-ec17590e3cfd
ANALYZE_WEBHOOK_TEST_URL=https://n8nnew.teraxr.com/webhook-test/add5d58a-54b1-4459-96f2-ec17590e3cfd

# Email Configuration (neshastyar.com SMTP)
SMTP_HOST=mail.neshastyar.com
SMTP_PORT=465
SMTP_USER=noreply@neshastyar.com
SMTP_PASS=your-mailbox-password
SMTP_FROM=noreply@neshastyar.com
SMTP_FROM_NAME=نشست یار
FRONTEND_URL=https://neshastyar.com
